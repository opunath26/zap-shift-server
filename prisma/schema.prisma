generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// 👤 User Model
model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String?
  email     String   @unique
  photoURL  String?
  role      String   @default("user")

  // Rider Specific Fields (Optional)
  phone     String?
  nid       String?
  license   String?
  region    String?
  district  String?
  bikeModel String?
  bikeRegNo String?
  about     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())
}

// 📦 Parcel Model (Updated for Express Backend Payload)
model Parcel {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  senderName      String?
  senderEmail     String
  senderPhone     String?
  senderAddress   String?

  receiverName    String?
  receiverPhone   String?
  receiverAddress String?

  parcelType      String?
  parcelWeight    Float?
  cost            Float?
  status          String   @default("pending")

  bookingDate     DateTime @default(now())
  createdAt       DateTime @default(now())
}