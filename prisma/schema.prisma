generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// 👤 User Model
model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String?
  email     String   @unique
  photoURL  String?
  role      String   @default("user")
  createdAt DateTime @default(now())
}

// 📦 Parcel Model
model Parcel {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  senderEmail  String
  receiverName String?
  price        Float?
  status       String   @default("pending")
  createdAt    DateTime @default(now())
}